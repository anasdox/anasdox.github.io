# Gemfile — only needed if you want to preview locally with `bundle exec jekyll serve`.
# GitHub Pages itself does not read this file; it builds with its own pinned environment.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "jekyll-feed"
gem "jekyll-seo-tag"

# Windows / WSL helpers (no-op on Linux/macOS)
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo"
  gem "tzinfo-data"
end
